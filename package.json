{
  "name": "dsh-think-chinese",
  "version": "1.0.0",
  "description": "DSH 插件：让模型的思考链（reasoning / thinking）始终用中文输出——为每个会话注入一条“用中文思考”的系统提示段落。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "reasoning",
    "thinking",
    "chain-of-thought",
    "chinese",
    "中文"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "MAINTAINING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/verify.mjs",
    "pack": "npm pack",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hielo19/dsh-think-chinese.git"
  },
  "bugs": {
    "url": "https://github.com/Hielo19/dsh-think-chinese/issues"
  },
  "homepage": "https://github.com/Hielo19/dsh-think-chinese#readme",
  "license": "MIT"
}
